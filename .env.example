# ============================================================
# Bawab Masr — بواب مصر
# Environment Variables Example (DO NOT add real values here)
# ============================================================

# قاعدة البيانات - Neon PostgreSQL
# استخدم رابط connection pooling للتطبيق
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# رابط مباشر للـ migrations (مطلوب في بعض إعدادات Neon + Prisma)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ============================================================
# NextAuth.js
# ============================================================
# توليد: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ============================================================
# SMS Provider (لإرسال OTP)
# اتركه فارغاً في التطوير — سيُستخدم مزود تجريبي داخلياً
# في الإنتاج: أضف بيانات مزود حقيقي مثل Twilio أو Infobip
# ============================================================
SMS_PROVIDER="dev"           # "dev" | "twilio" | "infobip"
SMS_API_KEY=""
SMS_SENDER_ID=""

# ============================================================
# رفع الملفات (File Storage)
# Vercel Blob أو S3 أو أي مزود
# ============================================================
BLOB_READ_WRITE_TOKEN=""

# ============================================================
# البيئة
# ============================================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="بواب مصر"
